generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  IDEE
  TODO
  ACTIE
}

enum ItemStatus {
  INBOX
  ACTIEF
  AFGEROND
}

model Project {
  id        String   @id @default(cuid())
  name      String
  color     String? // hex accent, optional
  createdAt DateTime @default(now())
  items     Item[]
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  items Item[]
}

model Item {
  id        String     @id @default(cuid())
  type      ItemType
  title     String
  body      String?
  status    ItemStatus @default(INBOX)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  tags Tag[]

  promotedFromNode BrainstormNode?
}

// --- Activiteiten-schema (routines) ---

model Routine {
  id         String        @id @default(cuid())
  name       String
  resetDaily Boolean       @default(true) // dagelijks opnieuw afvinken, of eenmalig blijvend
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
  steps      RoutineStep[]
}

model RoutineStep {
  id        String   @id @default(cuid())
  label     String
  icon      String // key uit de vaste iconenset, zie lib/icons.ts
  order     Int      @default(0)
  createdAt DateTime @default(now())

  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  routineId String

  completions RoutineCompletion[]
  reminders   Reminder[]
}

model RoutineCompletion {
  id     String @id @default(cuid())
  // "YYYY-MM-DD" voor een dagelijks resettende stap, of de vaste waarde "ALL"
  // voor een eenmalige stap die permanent afgevinkt blijft.
  dateKey String

  step   RoutineStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepId String

  @@unique([stepId, dateKey])
}

// --- Reminders ---

enum ReminderRepeat {
  EENMALIG
  DAGELIJKS
  WEKELIJKS
}

model Reminder {
  id       String         @id @default(cuid())
  title    String
  time     String // "HH:MM", 24-uurs, Europe/Amsterdam
  repeat   ReminderRepeat @default(DAGELIJKS)
  weekdays Int[] // 0=zo .. 6=za, alleen gebruikt bij WEKELIJKS
  active   Boolean        @default(true)
  createdAt DateTime      @default(now())

  // Voorkomt dubbel afvuren als de cron-check meerdere keren binnen dezelfde
  // minuut draait. Bevat een sleutel als "2026-08-11T08:00" (DAGELIJKS/WEKELIJKS)
  // of gewoon "FIRED" (EENMALIG, die daarna ook meteen op active=false gaat).
  lastFiredKey String?

  // optioneel gekoppeld aan een activiteiten-stap
  step   RoutineStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  stepId String?
}

// Web Push-abonnementen (browser/toestel), voor achtergrond-meldingen ook als
// de app gesloten is.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// --- Brainstorm (radiale mindmap) ---

model BrainstormSession {
  id        String           @id @default(cuid())
  title     String // centrale onderwerp, staat in het middelpunt
  createdAt DateTime         @default(now())
  nodes     BrainstormNode[]
}

model BrainstormNode {
  id        String   @id @default(cuid())
  label     String
  createdAt DateTime @default(now())

  session   BrainstormSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  // null = tak rechtstreeks vanaf het centrale onderwerp
  parent   BrainstormNode?  @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children BrainstormNode[] @relation("NodeChildren")

  // gezet zodra dit knooppunt is omgezet naar een Inbox-item
  promotedItem   Item?   @relation(fields: [promotedItemId], references: [id], onDelete: SetNull)
  promotedItemId String? @unique
}

// --- Instelbaar hoofdscherm ---

model ModuleSetting {
  id      String  @id @default(cuid())
  key     String  @unique // bv. "inbox", "projecten", "brainstorm", "activiteiten"
  visible Boolean @default(true)
  order   Int     @default(0)
}

// Welke pictogrammen zichtbaar zijn in de icoonkiezer bij activiteiten.
model IconSetting {
  id      String  @id @default(cuid())
  key     String  @unique // key uit lib/icons.ts
  visible Boolean @default(true)
  order   Int     @default(0)
}
